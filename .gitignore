# Media Evidence Vault & Storage (Raw footage must never be committed)
data/media/raw/*
data/media/derived/*
data/source_footage/*
data/datasets/*
data/artifacts/*
data/db/*.sqlite
data/db/*.db
!data/media/raw/.gitkeep
!data/media/derived/.gitkeep
!data/source_footage/.gitkeep
!data/datasets/.gitkeep
!data/artifacts/.gitkeep
!data/db/.gitkeep

# Local datasets, annotations, and generated segmentation artifacts.
# Keep full training photos, copied pilot images, LabelMe annotations (which
# may embed imageData), proposal masks, overlays, and experiment outputs out of
# the public repository. Force-add a specific reviewed text report only after
# checking it for private paths and sensitive metadata.
data/segmentation/
data/external_datasets/
data/training_data/
data/experiments/

# Large Video Files
*.mp4
*.avi
*.mov
*.mkv
*.wmv

# Heavy ML Weights & Checkpoints (Keep repository lightweight)
*.pt
*.pth
*.onnx
*.safetensors
*.bin
*.h5
!backend/app/models/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Local training environment and generated experiment outputs
.venv-training/
runs/
data/segmentation/
data/external_datasets/
data/training_data/
data/experiments/
